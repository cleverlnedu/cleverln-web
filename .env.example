# Shared Supabase project (the same project as CleverLN_LMS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: used by the /api routes. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Locally the website runs on :3000 and the LMS on :3001.
# In Vercel production leave both unset: they default to https://cleverln.com and https://lms.cleverln.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LMS_URL=http://localhost:3001

# Test checkout outside production (see docs/MOCK_CHECKOUT_ALLOWLIST.md).
MOCK_CHECKOUT_ENABLED=false

GEMINI_API_KEY=
